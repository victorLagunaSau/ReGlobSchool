# Copia este archivo a .env.local y llena los valores reales.
# Los encuentras en tu proyecto de Supabase: Project Settings -> API

# Seguras de exponer en el navegador (empiezan con NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA exponer al navegador. Solo se usa en Server Actions / Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Console -> APIs & Services -> habilita "Places API (New)" ->
# Credentials. Usado por src/app/api/leads/search/route.ts para la búsqueda
# en vivo de negocios (nunca se expone al navegador).
GOOGLE_MAPS_API_KEY=
